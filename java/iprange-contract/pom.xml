<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.iploc</groupId>
    <artifactId>iprange-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>iprange-contract</artifactId>
  <dependencies>
    <dependency>
      <groupId>io.iploc</groupId>
      <artifactId>iprange-java</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.13.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <properties><contract.test.directory>test-classes</contract.test.directory></properties>
  <build><testOutputDirectory>${project.build.directory}/${contract.test.directory}</testOutputDirectory></build>
  <profiles><profile><id>rust-jni</id>
    <dependencies><dependency><groupId>io.iploc</groupId><artifactId>iprange-rust</artifactId><version>${project.version}</version></dependency></dependencies>
    <properties><contract.test.directory>rust-test-classes</contract.test.directory></properties>
    <build><plugins>
      <plugin><groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><version>3.6.1</version>
        <executions><execution><id>rust-contract</id><phase>generate-test-sources</phase><goals><goal>add-test-source</goal></goals><configuration><sources><source>src/rust-test/java</source></sources></configuration></execution></executions>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><configuration>
        <argLine>-Xcheck:jni</argLine>
        <systemPropertyVariables><iploc.native.path>${maven.multiModuleProjectDirectory}/rust/target/release/libiprange_jni.so</iploc.native.path></systemPropertyVariables>
      </configuration></plugin>
    </plugins></build>
  </profile></profiles>
</project>
